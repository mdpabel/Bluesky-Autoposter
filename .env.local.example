# Bluesky credentials
# Your handle, e.g. yourname.bsky.social  (or a custom domain like mdpabel.com)
BLUESKY_IDENTIFIER=yourname.bsky.social
# App password from Settings -> Privacy and Security -> App Passwords
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# OpenAI
OPENAI_API_KEY=sk-proj-...
# Optional override. Defaults to gpt-5.6-terra.
OPENAI_POST_MODEL=gpt-5.6-terra

# Upstash Redis (REST API)
# Create a free database at upstash.com → Redis → Create Database
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Vercel Cron protection - any random string, e.g. output of: openssl rand -hex 32
# Add this same value in Vercel project settings -> Environment Variables
CRON_SECRET=replace-with-a-random-secret

# Book content library
# Publish 2 posts per Dhaka day by default. Set to 3 to activate three daily windows.
BOOK_POSTS_PER_DAY=2
# Used to vary the selected daily time windows and content order. Any private random string works.
BOOK_SCHEDULE_SEED=replace-with-another-random-secret
# Attached only to the four direct book-promotion posts. Value and soft posts have no link card.
BOOK_PROMOTION_URL=https://www.mdpabel.com/wordpress-malware-removal-book/

# Dashboard login
BASIC_AUTH_USER=replace-with-a-username
BASIC_AUTH_PASSWORD=replace-with-a-strong-password
